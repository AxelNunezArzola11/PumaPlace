DB_HOST=localhost
DB_PORT=3306
DB_USER=example_user
DB_PASSWORD=example_password
DB_NAME=pumaplace
# TiDB Cloud Starter (production): DB_SSL must be "true"; TLSv1.2+ with
# certificate verification is then enforced. Optional CA override as inline
# PEM or container file path.
DB_SSL=false
# DB_SSL_CA=/app/certs/tidb-ca.pem
PORT=3000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h
# Production CORS allows ONLY this origin (no wildcards, ever).
FRONTEND_URL=http://localhost:4200
MP_ACCESS_TOKEN=TEST-your_sandbox_access_token
MP_WEBHOOK_URL=https://your-public-url.example.com/api/pagos/webhook
# Mercado Pago webhook signing secret (x-signature). Required in production;
# without it the webhook answers 503 and nothing is processed.
MP_WEBHOOK_SECRET=replace_with_webhook_signing_secret
MP_BACK_URL_SUCCESS=http://localhost:4200/pago/retorno/exito
MP_BACK_URL_FAILURE=http://localhost:4200/pago/retorno/fallo
MP_BACK_URL_PENDING=http://localhost:4200/pago/retorno/pendiente
# 32 random bytes in base64: openssl rand -base64 32
ENCRYPTION_KEY=replace_with_base64_32_bytes
INDEX_KEY=replace_with_base64_32_bytes
